/* Sofle layout reconstructed from ZMK Studio screenshots.
 * macOS profile; home-row mod tap assignments confirmed by owner.
 * Symbols punctuation remains subject to host layout verification.
 * Home row mod-taps use tap-preferred to prevent cross-hand roll misfires.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <170>;
            bindings = <&kp>, <&kp>;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <170>;
            bindings = <&kp>, <&kp>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
                &kp ESC   &kp N1   &kp N2        &kp N3        &kp N4         &kp N5                                 &kp N6   &kp N7         &kp N8         &kp N9         &kp N0         &kp EQUAL
                &kp TAB   &kp Q    &kp W         &kp E         &kp R          &kp T                                  &kp Y    &kp U          &kp I          &kp O          &kp P          &kp LBRC
                &kp LCTRL &hml LGUI A &hml LALT S  &hml LCTRL D    &hml LSHFT F    &kp G                                  &kp H    &hmr RSHFT J    &hmr RCTRL K    &hmr RALT L     &hmr RGUI SEMI  &kp RBRC
                &kp LSHFT &kp Z    &kp X         &kp C         &kp V          &kp B          &kp C_MUTE  &none     &kp N    &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp SQT
                                     &kp LALT     &kp LALT      &kp LGUI       &lt 2 TAB       &lt 1 SPACE   &lt 1 RET    &lt 2 DEL      &kp DEL        &kp LCTRL      &kp LSHFT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        symbols_layer {
            display-name = "symbols";
            bindings = <
                &kp F12  &kp F1    &kp F2       &kp F3       &kp F4       &kp F5                               &kp F6    &kp F7      &kp F8    &kp F9     &kp F10     &kp F11
                &trans   &kp N1    &kp N2       &kp N3       &kp N4       &kp N5                               &kp N6    &kp EQUAL   &kp MINUS &kp FSLH   &kp SEMI    &trans
                &trans   &kp SQT   &kp SQT      &kp N9       &kp N0       &kp LBRC                             &kp RBRC  &kp MINUS   &kp EQUAL &kp N8     &kp SEMI    &kp N7
                &trans   &trans    &kp N7       &kp BSLH     &kp BSLH     &kp COMMA    &kp C_PLAY_PAUSE &none     &kp DOT &kp LBRC &kp RBRC &kp GRAVE &kp GRAVE &trans
                                    &trans      &trans       &trans       &trans          &trans         &trans   &trans       &trans      &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        navigation_layer {
            display-name = "navigation";
            bindings = <
                &trans   &trans    &trans      &trans      &trans       &trans                               &trans  &trans     &trans     &trans     &trans        &trans
                &trans   &kp INS   &kp PSCRN   &kp K_CMENU &trans &trans                              &trans  &trans     &trans     &trans     &trans        &trans
                &trans   &kp HOME  &kp PG_UP   &kp PG_DN   &kp END      &kp CAPSLOCK                              &trans  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT     &kp BSLH
                &trans   &kp LG(Z) &kp LG(X)   &kp LG(C)  &kp LG(V)  &trans     &trans         &trans     &trans  &trans     &trans     &trans     &kp BSLH      &trans
                                   &trans      &trans      &trans       &trans     &trans         &trans     &trans  &trans     &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };
    };
};
